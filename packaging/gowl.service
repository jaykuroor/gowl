# gowl screen sync as a systemd user service, started with the graphical session.
# `make install` copies this to ~/.config/systemd/user/gowl.service with ExecStart set
# to the installed binary's absolute path (the user manager's PATH lacks ~/.local/bin).
# It is enabled only if you ask (`make install AUTOSTART=1`, or `gowl setup`):
#
#   systemctl --user enable --now gowl     # screen sync at every login
#   systemctl --user disable --now gowl    # back to keys / quickshell only
#
# Stopping: `gowl stop`, `gowl toggle screen` (stop) and a toggle to music end this
# service with exit status 0, so systemd does not restart it (Restart=on-failure); it
# starts again at the next login or with `systemctl --user start gowl`. A sync started
# by a key while the service is stopped runs as an ordinary process of the compositor.
# Errors that retrying can fix (exit 1, 4 capture unavailable, 5 no LAN interface:
# a login before the network or the compositor is ready) are restarted after 2 s,
# stepping up to 60 s, with no start limit; gowl notifies a failure once, not on
# every retry. Errors that never fix themselves end it (RestartPreventExitStatus):
# 2 usage or bad config, 3 no light configured (run `gowl setup`), 6 the light is
# held by another gowl — a key-started sync, or a key/`gowl stop` used while the
# service waited to restart (GOWL_UNIT=1 tells gowl it runs as this service; D-065).

[Unit]
Description=gowl — sync Govee lights to the screen
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=%h/.local/bin/gowl screen
Environment=GOWL_UNIT=1
Restart=on-failure
RestartPreventExitStatus=2 3 6
RestartSec=2
RestartSteps=6
RestartMaxDelaySec=60
Nice=5

[Install]
WantedBy=graphical-session.target
